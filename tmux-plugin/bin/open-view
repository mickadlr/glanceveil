#!/bin/sh
set -eu

source_pane=${1-}
target_session=${2-}
plugin_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

case "$source_pane" in
  %*) ;;
  *)
    tmux display-message "GlanceVeil: could not identify the source pane"
    exit 1
    ;;
esac

option_or_default() {
  option_name=$1
  default_value=$2
  option_value=$(tmux show-options -gqv "$option_name")
  if [ -n "$option_value" ]; then
    printf '%s' "$option_value"
  else
    printf '%s' "$default_value"
  fi
}

pack=$(option_or_default @glanceveil-pack greek)
profile=$(option_or_default @glanceveil-profile dense)
clear_words=$(option_or_default @glanceveil-clear-words 0)
refresh_ms=$(option_or_default @glanceveil-refresh-ms 250)
variation_seed=$(option_or_default @glanceveil-variation-seed 0)

if ! command -v node >/dev/null 2>&1; then
  tmux display-message "GlanceVeil requires Node.js"
  exit 1
fi

view_command="'$(printf '%s' "$plugin_dir/bin/glanceveil-view" | sed "s/'/'\\\\''/g")'"
tmux display-message "GlanceVeil interactive view: press Ctrl-G twice to reveal the original"
tmux new-window \
  -t "${target_session}:" \
  -n "GlanceVeil" \
  -e "GLANCEVEIL_SOURCE_PANE=$source_pane" \
  -e "GLANCEVEIL_PACK=$pack" \
  -e "GLANCEVEIL_PROFILE=$profile" \
  -e "GLANCEVEIL_CLEAR_WORDS=$clear_words" \
  -e "GLANCEVEIL_REFRESH_MS=$refresh_ms" \
  -e "GLANCEVEIL_VARIATION_SEED=$variation_seed" \
  "$view_command"
